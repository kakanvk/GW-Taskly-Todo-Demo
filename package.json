{
  "name": "todo-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "json-server --watch server/db.json --host 127.0.0.1 --port 3001",
    "start": "concurrently -k -n WEB,API \"npm:dev\" \"npm:api\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "lucide-react": "0.468.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "json-server": "0.17.4",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
